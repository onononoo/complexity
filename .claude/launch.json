{
  "version": "0.0.1",
  "configurations": [
    { "name": "static", "runtimeExecutable": "node", "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path');const t={'.html':'text/html','.js':'text/javascript','.css':'text/css'};h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u.endsWith('/'))u+='index.html';f.readFile(p.join(process.cwd(),u),(e,d)=>{if(e){r.writeHead(404);r.end();return}r.writeHead(200,{'Content-Type':t[p.extname(u)]||'application/octet-stream'});r.end(d)})}).listen(8123)"], "port": 8123 }
  ]
}
